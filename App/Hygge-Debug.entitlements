<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Debug/personal builds hold development APNs tokens; the
	     staging sender pairs with this via HYGGE_APNS_ENVIRONMENT=sandbox. -->
	<key>aps-environment</key>
	<string>development</string>
	<!-- Without this, Sign in with Apple dies on device before any
	     backend call. -->
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
	<!-- Magic-link universal links on the API hosts. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:api.usehygge.app</string>
		<string>applinks:api-staging.usehygge.app</string>
	</array>
</dict>
</plist>
