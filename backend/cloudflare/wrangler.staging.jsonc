{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Staging environment. Separate config (not wrangler `env`) so the
  // container application, Durable Object namespace, D1, routes and
  // secrets all belong to this script alone.
  "name": "hygge-api-staging",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-31",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  "observability": { "logs": { "enabled": true }, "traces": { "enabled": true, "head_sampling_rate": 1 } },
  "routes": [
    { "pattern": "api-staging.usehygge.app", "custom_domain": true }
  ],
  // Brief 05: fleet scan sweeper, 3 slots/day UTC (07:00/13:00/19:00).
  // Signed-in sites scan every slot; public-only sites at 07:00.
  // Config is committed but NOT deployed by the implementer — the
  // coordinator deploys after confirming cron quota on the account.
  "triggers": { "crons": ["0 7 * * *", "0 13 * * *", "0 19 * * *"] },
  "containers": [
    { "class_name": "UserSandbox", "scheduling_policy": "durable_object", "images": { "base": { "image": "registry.cloudflare.com/89a95a21e6a6b7c15bbd8e148a6c6242/hygge-workspace@sha256:ae26f5d92b203d94f18bc13f1c121975459053c3b34d9ee2ea664d68f01d55ff" }, "recovery_v1": { "image": "registry.cloudflare.com/89a95a21e6a6b7c15bbd8e148a6c6242/hygge-workspace@sha256:1c7dcb73cd6ddd7bf9bea12fdbb8b4a7d6498bf87d95a772434797562f95b5f9" } } }
  ],
  "durable_objects": {
    "bindings": [
      { "class_name": "UserSandbox", "name": "USER_SANDBOX" }
    ]
  },
  "exports": {
    "UserSandbox": { "type": "durable-object", "storage": "sqlite" }
  },
  "vars": {
    "HYGGE_ENV": "staging",
    "HYGGE_TRACE_PAYLOADS": "1",
    // AI Gateway -> custom provider -> https://api.meta.ai/v1.
    // The Meta key lives in the gateway's stored keys (BYOK);
    // HYGGE_LLM_API_KEY remains only for rollback: use the Meta
    // URL directly AND delete the HYGGE_AIG_TOKEN secret.
    "HYGGE_LLM_BASE_URL": "https://gateway.ai.cloudflare.com/v1/89a95a21e6a6b7c15bbd8e148a6c6242/hygge-staging/custom-meta-ai/v1",
    "HYGGE_AIG_COLLECT_PAYLOAD": "1",
    "HYGGE_LLM_MODEL_FAST": "muse-spark-1.3",
    "HYGGE_LLM_MODEL_STRONG": "muse-wonder-1.0",
    "HYGGE_APPLE_BUNDLE_ID": "app.usehygge",
    // Retained workspace V2 is active in this environment. The
    // reviewed registry/postconditions below cover only the Wave 4
    // acceptance site; real-site sharing/completion rules are not
    // silently inferred. The pinned image is the reviewed Wave 4
    // image and must change only as a deliberate image upgrade.
    "HYGGE_WORKSPACE_MODE": "retained-v2",
    "HYGGE_WORKSPACE_NAMESPACE": "hygge-staging",
    "HYGGE_WORKSPACE_IMAGE_TRANSITIONS": "[{\"from\":\"registry.cloudflare.com/89a95a21e6a6b7c15bbd8e148a6c6242/hygge-workspace@sha256:ae26f5d92b203d94f18bc13f1c121975459053c3b34d9ee2ea664d68f01d55ff\",\"to\":\"registry.cloudflare.com/89a95a21e6a6b7c15bbd8e148a6c6242/hygge-workspace@sha256:1c7dcb73cd6ddd7bf9bea12fdbb8b4a7d6498bf87d95a772434797562f95b5f9\",\"policy\":\"workspace-filesystem-v1\"},{\"from\":\"registry.cloudflare.com/89a95a21e6a6b7c15bbd8e148a6c6242/hygge-workspace@sha256:1c7dcb73cd6ddd7bf9bea12fdbb8b4a7d6498bf87d95a772434797562f95b5f9\",\"to\":\"registry.cloudflare.com/89a95a21e6a6b7c15bbd8e148a6c6242/hygge-workspace@sha256:ae26f5d92b203d94f18bc13f1c121975459053c3b34d9ee2ea664d68f01d55ff\",\"policy\":\"workspace-filesystem-v1\"}]",
    "HYGGE_WORKSPACE_IMAGE": "registry.cloudflare.com/89a95a21e6a6b7c15bbd8e148a6c6242/hygge-workspace@sha256:ae26f5d92b203d94f18bc13f1c121975459053c3b34d9ee2ea664d68f01d55ff",
    "HYGGE_SKILL_REGISTRY": "{\"schemaVersion\":1,\"sites\":[{\"siteId\":\"wave4-jobs\",\"origin\":\"https://hygge-wave4-jobs.lemberg-89a.workers.dev\",\"routes\":{\"home\":\"/\",\"listings\":\"/listings\",\"apply\":\"/apply\",\"login\":\"/login\"},\"controls\":[\"Search\",\"Apply\",\"Submit\",\"Cover\"],\"fieldSets\":[\"listings\"],\"pitfalls\":[],\"review\":{\"policyVersion\":\"hygge-public-skills-v2.1\",\"reviewedRevision\":\"wave4-2026-11-03\",\"source\":\"developer_review\"}}]}",
    "HYGGE_WORKSPACE_POSTCONDITIONS": "[{\"origin\":\"https://hygge-wave4-jobs.lemberg-89a.workers.dev\",\"outcome\":\"apply\",\"pathname\":\"/apply/success\",\"requiredLabels\":[\"Application received\"],\"reviewedRevision\":\"wave4-2026-11-03\"}]",
    // Magic-link sign-in: links point at this origin; mail goes
    // out only from login@usehygge.app via the binding below.
    "HYGGE_MAGIC_BASE_URL": "https://api-staging.usehygge.app",
    // Brief 04 receive-only email domain. Email Routing (MX +
    // catch-all to this worker) is a dashboard step — see
    // docs/email-usehygge-cc.md. The only send binding is the
    // magic-link EMAIL sender below (login@usehygge.app).
    "HYGGE_EMAIL_DOMAIN": "usehygge.cc",
    // Brief 07: Debug builds hold development APNs tokens, so the
    // staging sender talks to Apple's sandbox host. The .p8 key is
    // a secret (HYGGE_APNS_KEY_P8) and the key/team ids live below — see docs/push-notifications.md.
    "HYGGE_APNS_ENVIRONMENT": "sandbox",
    "HYGGE_APNS_KEY_ID": "P7AKJ8SZL4",
    "HYGGE_APNS_TEAM_ID": "3KA38L8A4F"
  },
  // Durable mission queue (src/jobs.ts): approved work is
  // submitted here and delivered back into the owner's object to
  // run, so execution survives request/process termination. The
  // queues themselves are ensured by CI before deploy.
  "queues": {
    "producers": [
      { "binding": "MISSION_QUEUE", "queue": "hygge-missions-staging" }
    ],
    "consumers": [
      {
        "queue": "hygge-missions-staging",
        "max_batch_size": 1,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "retry_delay": 60,
        "dead_letter_queue": "hygge-missions-staging-dlq"
      },
      { "queue": "hygge-missions-staging-dlq", "max_batch_size": 1, "max_retries": 3 }
    ]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "hygge-staging", "database_id": "927c5fb0-c7ee-4430-a7b4-04eb06656777" }
  ],
  "r2_buckets": [
    { "binding": "BROWSER_PROFILES", "bucket_name": "hygge-browser-profiles-staging" },
    { "binding": "WORKSPACE_CHECKPOINTS", "bucket_name": "hygge-workspace-checkpoints-staging" }
  ],
  "browser": { "binding": "BROWSER" },
  "services": [
    { "binding": "SELF", "service": "hygge-api-staging" }
  ],
  "send_email": [
    { "name": "EMAIL", "allowed_sender_addresses": ["login@usehygge.app"] }
  ]
}
