{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Staging environment. Separate config (not wrangler `env`) so the
  // container application, Durable Object namespace, D1, routes and
  // secrets all belong to this script alone.
  "name": "hygge-api-staging",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-31",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  "observability": { "enabled": true },
  "routes": [
    { "pattern": "api-staging.usehygge.app", "custom_domain": true }
  ],
  "containers": [
    { "class_name": "UserSandbox", "scheduling_policy": "durable_object" }
  ],
  "durable_objects": {
    "bindings": [
      { "class_name": "UserSandbox", "name": "USER_SANDBOX" }
    ]
  },
  "exports": {
    "UserSandbox": { "type": "durable-object", "storage": "sqlite" }
  },
  "vars": {
    "HYGGE_ENV": "staging",
    "HYGGE_LLM_BASE_URL": "https://api.meta.ai/v1",
    "HYGGE_LLM_MODEL_FAST": "muse-spark-1.3",
    "HYGGE_LLM_MODEL_STRONG": "muse-wonder-1.0"
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "hygge-staging", "database_id": "927c5fb0-c7ee-4430-a7b4-04eb06656777" }
  ],
  // R2 not yet enabled on this account (dashboard action). Re-add
  // when enabled: bucket hygge-browser-profiles-staging.
  "browser": { "binding": "BROWSER" }
}
