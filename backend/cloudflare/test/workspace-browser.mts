import {test}from 'node:test';import assert from 'node:assert/strict';
import{WorkspaceBrowser}from '../src/workspace-browser.ts';import{createContainerWorkspace}from '../src/workspace-container.ts';import{signRpc,verifyRpc,validateTree}from '../src/workspace-container-protocol.ts';
const owner={environment:'staging' as const,userId:'alice',workspaceId:'workspace-a'},secret=new Uint8Array(32).fill(7),image='registry.example/hygge@sha256:'+'a'.repeat(64);
const identity={...owner,incarnation:'one',generation:1};
test('RPC signatures bind exact owner/incarnation/path/body and expiry',async()=>{const token=await signRpc(secret,identity,'/rpc','{}',1000);await verifyRpc(secret,identity,'/rpc','{}',token,1001);for(const bad of [{...identity,userId:'bob'},{...identity,incarnation:'two'}])await assert.rejects(verifyRpc(secret,bad,'/rpc','{}',token,1001));await assert.rejects(verifyRpc(secret,identity,'/rpc','{"changed":true}',token,1001));await assert.rejects(verifyRpc(secret,identity,'/rpc','{}',token,400_000));});
test('browser operations pin mission epoch even when new snapshot changes cached control',async()=>{let epoch=0,human=false;const seen=[];const browser=new WorkspaceBrowser({async call(op,args){if(op==='browser.snapshot'||op==='browser.create')return{sessionID:'s',currentURLString:'https://jobs.example/',title:'Synthetic',elements:[],humanControlled:human,controlEpoch:epoch,screenshotBase64:null}as any;if(op==='browser.act'){seen.push(args.epoch);if(args.epoch!==epoch||human)throw Error('browser control changed');return{sessionID:'s',currentURLString:'https://jobs.example/',humanControlled:human,controlEpoch:epoch}as any;}},async stream(){throw Error('unused');}});await browser.createSession('https://jobs.example/');await browser.agentStep('s',0,async()=>{epoch=1;await browser.snapshot('s');await assert.rejects(browser.act('s',{action:'click',target:'Apply'}),/control changed/);});assert.deepEqual(seen,[0]);human=true;await assert.rejects(browser.agentStep('s',1,async()=>{}),/control changed/);});
function baseBinding(){return{...owner,provider:'cloudflare' as const,namespaceId:'hygge-staging',providerWorkspaceId:'workspace-a',ownerDigest:'owner',schemaVersion:1,incarnation:'',generation:1,runtimeId:null,providerRuntimeId:null,desiredImageDigest:image,leaseExpiresAt:null,lifecycleState:'starting' as const,revision:1,recoveryPoint:null,lastVerifiedAt:new Date(1000).toISOString()};}
async function fixture(handle?:(q:any,boot:any)=>any){let labels:any=null,boot:any=null,running=false,initialized=false,destroyFails=false;const calledOps:string[]=[];const interceptHandlers:any[]=[];const container={get running(){return running;},start(options){running=true;(globalThis as any).__lastStart=options;labels=options.labels;boot=JSON.parse(options.env.HYGGE_IDENTITY);},async inspect(){return running?{image,labels}:null;},async destroy(){if(destroyFails)throw Error('STOP_UNKNOWN');running=false;},async monitor(){},async setInactivityTimeout(){},async interceptOutboundHttp(_target,handler){interceptHandlers.push(handler);},getTcpPort(){return{async fetch(req){const body=await req.text();await verifyRpc(secret,boot,'/rpc',body,req.headers.get('x-hygge-rpc')!,1000);const q=JSON.parse(body);calledOps.push(q.op);if(q.op==='initialize')initialized=true;if(handle&&q.op.startsWith('artifact.'))return new Response(JSON.stringify({result:await handle(q,boot)}));return new Response(JSON.stringify({result:{...boot,initialized,recoveredCheckpointId:null,filesystemRevision:0,browserProfileRevision:0,...(handle?{artifactProtocolVersion:1,maxArtifactBytes:8*1024*1024}:{})}}));}};}};let lease:any;const denyFetcher={fetch:async()=>new Response('denied',{status:403})};const config={owner,container,image,denyFetcher,rpcSecret:secret,namespaceId:'hygge-staging',providerWorkspaceId:'workspace-a',objects:{putImmutable:async()=>{},get:async()=>null},getLease:async()=>lease,now:()=>1000};const bridge=createContainerWorkspace(config);const start=await bridge.provider.start(baseBinding(),'op1');const binding={...baseBinding(),...start,providerRuntimeId:start.providerRuntimeId,lifecycleState:'ready' as const,leaseExpiresAt:new Date(61_000).toISOString()};lease={...owner,...start,generation:1,leaseId:'canonical',expiresAt:new Date(61_000).toISOString()};return{bridge,binding,config,container,calledOps,denyFetcher,interceptHandlers,replaceRuntime(){labels={...labels,incarnation:'replacement',generation:'2'};boot={...boot,incarnation:'replacement',generation:2};return{...binding,incarnation:'replacement',providerRuntimeId:'replacement',generation:2};},setStopUnknown(){destroyFails=true;},changeLabels(){labels.incarnation='other';}};}
test('DO reconstruction attaches exact retained incarnation without starting a new runtime',async()=>{const f=await fixture();const reconstructed=createContainerWorkspace(f.config);await reconstructed.attach(f.binding);assert.equal((await reconstructed.status()).incarnation,f.binding.incarnation);f.changeLabels();await assert.rejects(reconstructed.attach(f.binding),/MISMATCH/);});
test('provider fence returns evidence only after exact stop+monitor+absence readback',async()=>{const f=await fixture();f.setStopUnknown();await assert.rejects(f.bridge.provider.fence(f.binding,'stop'),/STOP_UNKNOWN/);assert.equal(f.container.running,true);const ok=await fixture();const proof=await ok.bridge.provider.fence(ok.binding,'stop');assert.equal(proof.previousIncarnation,ok.binding.incarnation);assert.equal(proof.browserRetired,true);assert.equal(ok.container.running,false);});
test('safe restore metadata rejects escaping links and child traversal through link/file',()=>{const tree={files:[{path:'file',mode:384,size:0,hash:'a'.repeat(64)}],directories:[],symlinks:[{path:'alias',target:'file'}],artifacts:{}};validateTree(tree);assert.throws(()=>validateTree({...tree,symlinks:[{path:'alias',target:'../bob'}]}));assert.throws(()=>validateTree({...tree,files:[...tree.files,{path:'alias/child',mode:384,size:0,hash:'a'.repeat(64)}]}));});

test('symlink chains cannot escape through an intermediate link',()=>{const chain={files:[{path:'evil',mode:384,size:0,hash:'a'.repeat(64)}],directories:[{path:'d',mode:448},{path:'x',mode:448}],symlinks:[{path:'d/link',target:'../x'},{path:'b',target:'d/link/../../evil'}],artifacts:{}};assert.throws(()=>validateTree(chain),/UNSAFE_LINK|DANGLING_LINK/);const safe={files:[{path:'notes/a.txt',mode:384,size:0,hash:'a'.repeat(64)}],directories:[{path:'notes',mode:448},{path:'links',mode:448}],symlinks:[{path:'links/inner',target:'../notes/a.txt'},{path:'alias',target:'links/inner'}],artifacts:{}};validateTree(safe);});
test('tool RPC cannot acquire replacement identity during async signing',async()=>{const f=await fixture();const nativeSign=crypto.subtle.sign.bind(crypto.subtle);let armed=true;(crypto.subtle as any).sign=async(...args:any[])=>{if(armed){armed=false;await f.bridge.attach(f.replaceRuntime());}return (nativeSign as any)(...args);};try{await assert.rejects(f.bridge.writeArtifact('old-evidence',new Uint8Array([1])),/STALE_GENERATION/);assert.equal(f.calledOps.includes('artifact.write'),false);}finally{(crypto.subtle as any).sign=nativeSign;}});
test('WebSocket admission cannot acquire replacement identity during async signing',async()=>{const f=await fixture();const nativeSign=crypto.subtle.sign.bind(crypto.subtle);let armed=true;(crypto.subtle as any).sign=async(...args:any[])=>{if(armed){armed=false;await f.bridge.attach(f.replaceRuntime());}return (nativeSign as any)(...args);};try{await assert.rejects(f.bridge.browser.stream('old-session',async()=>{}),/STALE_GENERATION/);}finally{(crypto.subtle as any).sign=nativeSign;}});

test('fresh runtime start refuses to boot without a real outbound-deny fetcher',async()=>{const f=await fixture();await f.container.destroy();const bare=createContainerWorkspace({...f.config,denyFetcher:undefined} as any);await assert.rejects(bare.provider.start(f.binding,'deny-op'),/OUTBOUND_DENY_FETCHER_REQUIRED/);assert.equal(f.container.running,false);});
test('fresh runtime start installs the configured deny fetcher for every private range',async()=>{const f=await fixture();assert.ok(f.interceptHandlers.length>=9);assert.ok(f.interceptHandlers.every(h=>h===f.denyFetcher));});

test('rpc verification tolerates bounded container clock skew but not unbounded expiry',async()=>{const id={environment:'staging',userId:'u',workspaceId:'w',incarnation:'i1',generation:1};const tok=await signRpc(secret,id,'/rpc','{}',1_000_000);await verifyRpc(secret,id,'/rpc','{}',tok,1_000_000-240_000);await assert.rejects(verifyRpc(secret,id,'/rpc','{}',tok,1_000_000-400_000),/UNAUTHORIZED/);await assert.rejects(verifyRpc(secret,id,'/rpc','{}',tok,1_000_000+400_000),/UNAUTHORIZED/);});

test('fresh runtime start requests a Chromium-capable instance size',async()=>{await fixture();assert.equal((globalThis as any).__lastStart?.instance,'standard-2');});

test('large artifact bridge chunks one verified manifest and never acknowledges partial content',async()=>{
 const bytes=new Uint8Array(578754).fill(42),chunks:Uint8Array[]=[];let manifest:any,commits=0;
 const f=await fixture(async q=>{
  if(q.op==='artifact.begin'){manifest=q.args;return{uploadId:'transfer',received:0,committed:false};}
  if(q.op==='artifact.chunk'){const chunk=Uint8Array.from(Buffer.from(q.args.data,'base64'));assert.ok(chunk.length<=256*1024);assert.equal(q.args.offset,chunks.reduce((n,b)=>n+b.length,0));chunks.push(chunk);return{received:q.args.offset+chunk.length};}
  if(q.op==='artifact.commit'){commits++;assert.equal(q.args.sha256,manifest.sha256);return{committed:true,size:manifest.size,sha256:manifest.sha256};}
 });
 const result:any=await f.bridge.writeArtifact('evidence',bytes);assert.equal(result.committed,true);assert.equal(commits,1);assert.equal(chunks.length,3);assert.deepEqual(Buffer.concat(chunks),Buffer.from(bytes));
 const bad=await fixture(async q=>q.op==='artifact.begin'?{uploadId:'transfer',received:0}:q.op==='artifact.chunk'?{received:999}:{});
 await assert.rejects(bad.bridge.writeArtifact('bad',bytes),/TRANSFER_INVALID/);assert.ok(bad.calledOps.includes('artifact.abort'));assert.ok(!bad.calledOps.includes('artifact.commit'));
});
test('old image remains compatible for small writes and explicitly gates multipart upgrades',async()=>{
 const f=await fixture();await f.bridge.writeArtifact('small',new Uint8Array([1]));assert.ok(f.calledOps.includes('artifact.write'));
 await assert.rejects(f.bridge.writeArtifact('large',new Uint8Array(256*1024+1)),/PROTOCOL_UPGRADE_REQUIRED/);assert.ok(!f.calledOps.includes('artifact.begin'));
});
test('multipart transfer cannot continue or abort in a replacement runtime',async()=>{
 let f:any;f=await fixture(async q=>{
  if(q.op==='artifact.begin')return{uploadId:'old',received:0};
  if(q.op==='artifact.chunk'){await f.bridge.attach(f.replaceRuntime());return{received:256*1024};}
 });
 await assert.rejects(f.bridge.writeArtifact('evidence',new Uint8Array(578754)),/STALE_GENERATION/);
 assert.equal(f.calledOps.filter(op=>op==='artifact.chunk').length,1);assert.ok(!f.calledOps.includes('artifact.commit'));assert.ok(!f.calledOps.includes('artifact.abort'));
});
