import {test} from 'node:test';import assert from 'node:assert/strict';
import {WorkspaceRegistry} from '../src/workspace-runtime.ts';
import {WorkspaceCaptureService,r2WorkspaceObjects,UnsupportedNativeCapture} from '../src/workspace-capture.ts';
import {A,B,NOW,binding,lease,MemoryTransactions,FakeProvider} from './fixtures/workspace-foundation.ts';
const enc=new TextEncoder();
async function fixture(){
 const storage=new MemoryTransactions(),provider=new FakeProvider(),registry=new WorkspaceRegistry(storage,provider,()=>NOW);await registry.initialize(A,binding());const ready=await registry.ensure(A,A,'start');const currentLease=await registry.readLease(A,A);
 const objects={data:new Map<string,Uint8Array>(),fail:false,async putImmutable(k:string,b:Uint8Array){if(this.fail)throw Error('OBJECT_STORE_DOWN');if(!this.data.has(k))this.data.set(k,b.slice());},async get(k:string){return this.data.get(k)?.slice()??null;}};
 const driver={releaseFail:false,unsafe:false,captures:0,async capture(l:any,q:any){this.captures++;return{snapshot:{incarnation:l.incarnation,generation:l.generation,filesystemRevision:q.filesystemRevision,browserProfileRevision:q.browserProfileRevision,browserState:q.browserProfileRevision?'quiesced':'absent',directories:[{path:'notes',mode:0o700}],files:[{path:this.unsafe?'../bob/secret':'notes/private.txt',bytes:enc.encode('alice private notes')}],artifacts:{note:'notes/private.txt'}},release:async()=>{if(this.releaseFail){this.releaseFail=false;throw Error('ACK_LOST');}}};}};
 const service=new WorkspaceCaptureService(registry,objects,driver as any,()=>NOW),request={writeId:'save1',expectedRegistryRevision:ready.revision,filesystemRevision:1,browserProfileRevision:0,artifactRefs:['note']};return{registry,provider,objects,driver,service,request,ready,currentLease};
}
test('committed checkpoint independently verifies after capture driver loss; owner denied',async()=>{const f=await fixture();const r=await f.service.commit(A,f.currentLease,f.request);assert.equal(r.recoveryPoint.sequence,1);assert.deepEqual((await f.service.verifyReceipt(A,A,r.receiptId)).coveredArtifactRefs,['note']);await assert.rejects(f.service.verifyReceipt(B,A,r.receiptId),/OWNER_MISMATCH/);assert.ok([...f.objects.data.keys()].every(k=>k.includes('/alice/ws-a/')));});
test('failed object upload never advances recovery pointer or receipt',async()=>{const f=await fixture();f.objects.fail=true;await assert.rejects(f.service.commit(A,f.currentLease,f.request),/OBJECT_STORE_DOWN/);assert.equal((await f.registry.read(A,A)).recoveryPoint,null);assert.equal(await f.registry.saved(A,A,'save1'),undefined);});
test('tampered blob or missing manifest cannot verify accepted durability',async()=>{const f=await fixture();const r=await f.service.commit(A,f.currentLease,f.request);const key=[...f.objects.data.keys()].find(k=>k.includes('/blobs/'))!;f.objects.data.set(key,enc.encode('corrupt'));await assert.rejects(f.service.verifyReceipt(A,A,r.receiptId),/VERIFICATION_FAILED/);});
test('acknowledgement loss retries original durable receipt without recapture',async()=>{const f=await fixture();f.driver.releaseFail=true;await assert.rejects(f.service.commit(A,f.currentLease,f.request),/ACK_LOST/);const result=await f.service.commit(A,f.currentLease,f.request);assert.equal(result.writeId,'save1');assert.equal(f.driver.captures,1);await assert.rejects(f.service.commit(A,f.currentLease,{...f.request,filesystemRevision:2}),/IDEMPOTENCY_CONFLICT/);});
test('lease revoked during capture upload cannot publish a stale recovery head',async()=>{const f=await fixture();const put=f.objects.putImmutable.bind(f.objects);let first=true;f.objects.putImmutable=async(k,b)=>{await put(k,b);if(first){first=false;await f.registry.fence(A,A,f.ready.generation,'stop');}};await assert.rejects(f.service.commit(A,f.currentLease,f.request),/STALE_GENERATION|STALE_LEASE/);assert.equal((await f.registry.read(A,A)).recoveryPoint,null);});
test('unsafe paths rejected before object writes; browser capture unavailable stays blocked',async()=>{const f=await fixture();f.driver.unsafe=true;await assert.rejects(f.service.commit(A,f.currentLease,f.request),/UNSAFE_CAPTURE_PATH/);assert.equal(f.objects.data.size,0);const blocked=new WorkspaceCaptureService(f.registry,f.objects,new UnsupportedNativeCapture(),()=>NOW);await assert.rejects(blocked.commit(A,f.currentLease,f.request),/CAPTURE_ADAPTER_REQUIRED/);});
test('verified recovery enables replacement with new incarnation; stale lease rejected',async()=>{const f=await fixture();await f.service.commit(A,f.currentLease,f.request);await f.registry.fence(A,A,f.ready.generation,'stop');const next=await f.registry.ensure(A,A,'replace');assert.notEqual(next.incarnation,f.ready.incarnation);assert.equal(next.generation,2);await assert.rejects(f.registry.heartbeat(A,f.currentLease),/STALE_GENERATION|STALE_LEASE/);});
test('R2 adapter checks immutable collision contents using readback',async()=>{const data=new Map();const bucket={put:async(k,b)=>{if(!data.has(k))data.set(k,b.slice());},get:async k=>data.has(k)?{arrayBuffer:async()=>data.get(k).slice().buffer}:null};const obj=r2WorkspaceObjects(bucket as any);await obj.putImmutable('private-key',enc.encode('one'));await assert.rejects(obj.putImmutable('private-key',enc.encode('two')),/VERIFICATION_FAILED/);});
test('live browser state cannot pass consistent capture gate',async()=>{const f=await fixture();const capture=f.driver.capture.bind(f.driver);f.driver.capture=async(l,q)=>{const result=await capture(l,q);(result.snapshot as any).browserState='live';return result;};await assert.rejects(f.service.commit(A,f.currentLease,{...f.request,browserProfileRevision:1}),/BROWSER_NOT_QUIESCED/);assert.equal((await f.registry.read(A,A)).recoveryPoint,null);});
test('declared artifact missing from captured files cannot be acknowledged',async()=>{const f=await fixture();await assert.rejects(f.service.commit(A,f.currentLease,{...f.request,artifactRefs:['missing']}),/ARTIFACT_NOT_CAPTURED/);assert.equal(await f.registry.saved(A,A,'save1'),undefined);});
test('concurrent registry revision change rejects recovery-head CAS',async()=>{const f=await fixture();const put=f.objects.putImmutable.bind(f.objects);let first=true;f.objects.putImmutable=async(k,b)=>{await put(k,b);if(first){first=false;await f.registry.heartbeat(A,f.currentLease);}};await assert.rejects(f.service.commit(A,f.currentLease,f.request),/REVISION_CONFLICT/);assert.equal((await f.registry.read(A,A)).recoveryPoint,null);});
test('missing checkpoint manifest blocks independent recovery proof',async()=>{const f=await fixture();const r=await f.service.commit(A,f.currentLease,f.request);const manifest=[...f.objects.data.keys()].find(k=>k.includes('/manifests/'))!;f.objects.data.delete(manifest);await assert.rejects(f.service.verifyReceipt(A,A,r.receiptId),/MANIFEST_VERIFICATION_FAILED/);});
test('committed revisions cannot regress or reuse a revision for new bytes',async()=>{const f=await fixture();await f.service.commit(A,f.currentLease,f.request);const b=await f.registry.read(A,A);await assert.rejects(f.service.commit(A,await f.registry.readLease(A,A),{...f.request,writeId:'save2',expectedRegistryRevision:b.revision}),/REVISION_REGRESSION/);});
test('manifest preserves executable modes, empty directories and safe internal links',async()=>{const f=await fixture();const capture=f.driver.capture.bind(f.driver);f.driver.capture=async(l,q)=>{const result=await capture(l,q);const s=result.snapshot as any;s.files[0].mode=0o755;s.directories.push({path:'empty',mode:0o750});s.symlinks=[{path:'note-link',target:'notes/private.txt'}];return result;};await f.service.commit(A,f.currentLease,f.request);const manifestKey=[...f.objects.data.keys()].find(k=>k.includes('/manifests/'))!;const m=JSON.parse(new TextDecoder().decode(f.objects.data.get(manifestKey)));assert.equal(m.files[0].mode,0o755);assert.ok(m.directories.some(d=>d.path==='empty'&&d.mode===0o750));assert.deepEqual(m.symlinks,[{path:'note-link',target:'notes/private.txt'}]);await f.service.verifyReceipt(A,A,'save1');});
test('escape links, duplicate paths and file parents fail before immutable upload',async()=>{for(const bad of ['escape','duplicate','file-parent','chain-escape']){const f=await fixture();const capture=f.driver.capture.bind(f.driver);f.driver.capture=async(l,q)=>{const result=await capture(l,q);const s=result.snapshot as any;if(bad==='escape')s.symlinks=[{path:'link',target:'../bob/secrets'}];if(bad==='duplicate')s.directories.push({path:'notes/private.txt',mode:0o700});if(bad==='file-parent')s.files.push({path:'notes/private.txt/child',bytes:enc.encode('x')});if(bad==='chain-escape'){s.directories.push({path:'d',mode:0o700},{path:'x',mode:0o700});s.files.push({path:'evil',mode:0o600,bytes:enc.encode('x')});s.symlinks=[{path:'d/link',target:'../x'},{path:'b',target:'d/link/../../evil'}];}return result;};await assert.rejects(f.service.commit(A,f.currentLease,f.request),/UNSAFE_/);assert.equal(f.objects.data.size,0);}});
test('capture detaches byte arrays and metadata before asynchronous upload',async()=>{const f=await fixture();const capture=f.driver.capture.bind(f.driver);let raw:any;f.driver.capture=async(l,q)=>{const result=await capture(l,q);raw=result.snapshot;return result;};const put=f.objects.putImmutable.bind(f.objects);let first=true;f.objects.putImmutable=async(k,b)=>{if(first){first=false;raw.files[0].bytes.fill(0);raw.files[0].path='../other-owner';raw.directories.length=0;}await put(k,b);};await f.service.commit(A,f.currentLease,f.request);await f.service.verifyReceipt(A,A,'save1');const blob=[...f.objects.data.entries()].find(([k])=>k.includes('/blobs/'))!;assert.equal(new TextDecoder().decode(blob[1]),'alice private notes');});
test('capture resource caps are explicit configurable interim transport bounds',async()=>{const f=await fixture();const limited=new WorkspaceCaptureService(f.registry,f.objects,f.driver as any,()=>NOW,{maxEntries:1,maxBytes:1024});await assert.rejects(limited.commit(A,f.currentLease,f.request),/CAPTURE_LIMIT_EXCEEDED/);assert.equal(f.objects.data.size,0);});
